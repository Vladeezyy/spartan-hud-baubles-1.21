{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}\nUnofficial port of Spartan HUD: Baubles 1.0.0 (ObliviousSpartan, LGPL-3.0) to Minecraft ${minecraft_version} / Fabric and Trinkets.",
  "authors": ["${mod_authors}"],
  "contributors": ["Shivaxi (ideas)", "Vladeezyy (port)"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/spartan-hud-baubles",
    "sources": "https://github.com/Vladeezyy/spartan-hud-baubles-1.21",
    "issues": "https://github.com/Vladeezyy/spartan-hud-baubles-1.21/issues"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.oblivioussp.spartanhudbaubles.fabric.SpartanHUDBaublesFabric"],
    "client": ["com.oblivioussp.spartanhudbaubles.fabric.SpartanHUDBaublesFabricClient"]
  },
  "mixins": ["spartanhudbaubles.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "forgeconfigapiport": ">=${forgeconfigapiport_version}",
    "trinkets": ">=3.10.0",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
